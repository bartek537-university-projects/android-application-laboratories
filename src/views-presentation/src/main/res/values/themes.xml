<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AndroidApplicationLaboratories" parent="Theme.Material3Expressive.DayNight.NoActionBar" />

    <style name="Base.Labs.StickyNote" parent="Widget.AppCompat.TextView">
        <item name="android:background">@android:color/system_accent1_200</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:fontFamily">casual</item>
        <item name="android:padding">24dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="Labs.StickyNote" parent="Base.Labs.StickyNote" />

    <style name="Labs.StickyNote.Light">
        <item name="android:background">@android:color/holo_orange_light</item>
    </style>

    <style name="Labs.StickyNote.Dark">
        <item name="android:background">@android:color/holo_orange_dark</item>
    </style>

</resources>