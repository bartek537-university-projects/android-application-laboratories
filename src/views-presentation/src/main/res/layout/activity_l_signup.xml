<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presentation.l.SignupActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            app:expandedTitleGravity="bottom"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:title="Sign up" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/username_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:importantForAccessibility="no"
                android:labelFor="@id/username_input"
                android:src="@drawable/user"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/username_input"
                app:tint="?attr/colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/username_input"
                android:layout_width="256dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:hint="@string/user_name"
                app:layout_constraintStart_toEndOf="@+id/username_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderText="john123">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />

            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:id="@+id/password_original_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:importantForAccessibility="no"
                android:labelFor="@id/password_original_input"
                android:src="@drawable/password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/password_original_input"
                app:tint="?attr/colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_original_input"
                android:layout_width="256dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:hint="@string/password"
                app:layout_constraintStart_toEndOf="@+id/password_original_icon"
                app:layout_constraintTop_toBottomOf="@+id/username_input">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/password_requirements_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="@id/password_original_input"
                app:layout_constraintTop_toBottomOf="@id/password_original_input">

                <CheckBox
                    android:id="@+id/password_has_minimum_length_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/has_at_least_8_characters"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

                <CheckBox
                    android:id="@+id/password_has_digit_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-16dp"
                    android:enabled="false"
                    android:text="@string/has_at_least_1_digit"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

                <CheckBox
                    android:id="@+id/password_has_lower_case_letter_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-16dp"
                    android:enabled="false"
                    android:text="@string/has_at_least_1_lower_case_letter"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

                <CheckBox
                    android:id="@+id/password_has_upper_case_letter_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-16dp"
                    android:enabled="false"
                    android:text="@string/has_at_least_1_upper_case_letter"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_repeat_input"
                android:layout_width="256dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/repeat_password"
                app:layout_constraintStart_toStartOf="@+id/username_input"
                app:layout_constraintTop_toBottomOf="@+id/password_requirements_layout">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:fitsSystemWindows="true">

        <Button
            android:id="@+id/continue_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>